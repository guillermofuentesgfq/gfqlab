---
import ThemeToggle from '@/components/ThemeToggle.astro';
import { SITE, NAV_LINKS } from '@/site.config';

// `currentPath` viene con barra final en build (`/about/`) pero Astro también
// entrega `/about` sin ella según la ruta que se pidió. Comparar contra el
// `href` tal cual dejaba las páginas de detalle sin marcar, porque
// `/work/ecs-aws-infra/` no empieza por `/work//`. Normalizar las dos puntas a
// la misma forma —quitando la barra final— hace que este check sea
// equivalente a `path === href || path.startsWith(href + '/')`.
const currentPath = Astro.url.pathname.replace(/\/+$/, '');
---

<header class="border-line bg-paper/90 sticky top-0 z-40 border-b backdrop-blur">
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-6 py-4">
    <a href="/" class="font-display text-ink text-lg font-medium">
      {SITE.name}
    </a>

    <nav class="flex items-center gap-5" aria-label="Primary">
      {
        NAV_LINKS.map((link) => {
          const isActive = currentPath === link.href.replace(/\/+$/, '');
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'font-mono text-xs tracking-wide uppercase transition-colors',
                isActive ? 'text-signal' : 'text-ink-soft hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
      <a
        href="/#contact"
        class="text-ink-soft hover:text-ink hidden font-mono text-xs tracking-wide uppercase transition-colors sm:inline"
      >
        Contact
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>
