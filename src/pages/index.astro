---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import WorkRow from '@/components/WorkRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { SITE } from '@/site.config';

const allWork = await getCollection('work', ({ data }) => !data.draft);
const sorted = [...allWork].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = sorted.filter((entry) => entry.data.featured);
const rest = sorted.filter((entry) => !entry.data.featured);
const selected = [...featured, ...rest].slice(0, 5);

// Three most recent papers. The full list lives on /publications; the home page
// only needs enough to make the research line visible without pushing the
// contact section off the first screen.
const papers = (await getCollection('publications', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const recentPapers = papers.slice(0, 3);
---

<BaseLayout title={SITE.name}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-20 sm:pt-24">
    <p class="text-ink-soft mb-6 inline-flex items-center gap-2 font-mono text-xs">
      <span class="bg-signal h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
      {SITE.status}
    </p>

    <h1 class="font-display text-ink max-w-2xl text-4xl leading-[1.1] font-medium sm:text-5xl">
      {SITE.tagline}
    </h1>

    <p class="text-ink-soft mt-6 max-w-md">
      Ten years across platform modernization, AI-enabled development and product
      transformation — currently leading 60+ engineers across 9 teams.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <Button href="/work/" variant="solid">View the work →</Button>
      <Button href="#contact" variant="ghost">Say hello</Button>
    </div>
  </section>

  <section id="work" class="mx-auto max-w-3xl px-6 pb-20">
    <SectionHeading eyebrow="Selected work" count={allWork.length} />
    <div>
      {selected.map((entry) => <WorkRow entry={entry} />)}
    </div>
    {
      allWork.length > selected.length && (
        <div class="mt-6">
          <a
            href="/work/"
            class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
          >
            View all {allWork.length} projects →
          </a>
        </div>
      )
    }
  </section>

  <section id="publications" class="mx-auto max-w-3xl px-6 pb-20">
    <SectionHeading eyebrow="Writing" count={papers.length} />
    <ul class="border-line border-b">
      {
        recentPapers.map((paper) => (
          <li class="border-line border-t py-5">
            <a href={`/publications/${paper.id}/`} class="group block">
              <span class="font-display text-ink group-hover:text-signal block text-lg leading-snug transition-colors">
                {paper.data.title}
              </span>
              <span class="text-ink-soft mt-1 block font-mono text-xs">
                {paper.data.venue} · {paper.data.date.getUTCFullYear()}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-6">
      <a
        href="/publications/"
        class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
      >
        All publications →
      </a>
    </div>
  </section>

  <section id="about" class="mx-auto max-w-3xl px-6 pb-20">
    <SectionHeading eyebrow="About" />
    <p class="text-ink-soft max-w-xl">{SITE.description}</p>
    <a href="/about/" class="text-signal mt-4 inline-block font-mono text-xs hover:underline">
      More about how I work →
    </a>
  </section>

  <section id="contact" class="mx-auto max-w-3xl px-6 pb-24">
    <SectionHeading eyebrow="Let's talk" />
    <p class="font-display text-ink max-w-lg text-2xl sm:text-3xl">
      Have something worth building?
    </p>
    <a
      href={`mailto:${SITE.email}`}
      class="text-signal mt-4 inline-flex items-center gap-2 font-mono hover:underline"
    >
      {SITE.email}
    </a>
  </section>
</BaseLayout>